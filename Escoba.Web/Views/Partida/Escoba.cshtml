@* Vista fuertemente tipada con un ViewModel: no recibe la entidad Partida completa,
   así el HTML nunca incluye las cartas del rival. *@
@model Escoba.Entidades.PartidaViewModel
@{
    ViewData["Title"] = Model.NombrePartida;

    const int maxJugadores = 2;
    int jugadoresActuales = Model.Jugadores.Count;
    int miUsuarioId = Context.Session.GetInt32("UsuarioId") ?? 0;

    bool enEspera = Model.Estado == Escoba.Entidades.EnumPartida.EnEspera;
    bool enCurso = Model.Estado == Escoba.Entidades.EnumPartida.EnCurso;

    // Datos del rival y de quien tiene el turno (el rival puede no existir mientras se espera).
    var rival = Model.Jugadores.FirstOrDefault(j => j.UsuarioId != miUsuarioId);
    var jugadorEnTurno = Model.Jugadores.FirstOrDefault(j => j.UsuarioId == Model.TurnoJugadorUsuarioId);

    string claseEstado = enEspera ? "alert-warning text-warning border-warning"
                       : enCurso ? "alert-success text-success border-success"
                       : "alert-secondary text-light border-secondary";
}

<div class="container mt-2 mb-0 text-center">
    <div class="container-bar mb-4 mesa-truco @(enCurso || Model.Estado == Escoba.Entidades.EnumPartida.Finalizado ? "mesa-con-mano" : "")">
        <h2 class="titulo-bar fs-2 text-white m-0">
            @Model.NombrePartida 
        </h2>
        <div class="col-md-3 col-12 text-center text-md-start mb-3 mb-md-0">
            <button type="button" id="salirMesa" class="btn btn-secondary btn-sm px-3 py-2">
                🚪 Salir de la Mesa
            </button>
        </div>
        <hr class="border-secondary my-3">

        <!-- Estado de la partida dinámico al cargar -->
        <div id="estadoPartida" class="alert @claseEstado bg-dark py-2 mb-2 d-inline-block px-4">
            @if (enEspera)
            {
                <span>⏳ Estado: <strong>Esperando jugadores (@jugadoresActuales/@maxJugadores)...</strong></span>
            }
            else if (enCurso && Model.EsMiTurno)
            {
                <span>🎴 Estado: <strong>¡Es tu turno!</strong></span>
            }
            else if (enCurso)
            {
                <span>🎴 Estado: <strong>Turno de @(jugadorEnTurno?.Nombre ?? "tu rival")</strong></span>
            }
            else
            {
                <span>🏁 Estado: <strong>Partida finalizada</strong></span>
            }
        </div>
       


        @if (enEspera)
        {
            <h5 class="text-light mb-3">Jugadores en la Mesa:</h5>

            <!-- Lista dinámica de jugadores -->
            <ul id="listaJugadores" class="list-group list-group-flush mx-auto" style="max-width: 400px;">
                @foreach (var j in Model.Jugadores)
                {
                    <li class="list-group-item bg-dark text-light border-secondary d-flex justify-content-between align-items-center">
                        <span>@j.Nombre</span>
                        <span class="badge bg-success">Conectado</span>
                    </li>
                }
            </ul>
        }

        @if (enCurso || Model.Estado == Escoba.Entidades.EnumPartida.Finalizado)
        {

            <section class="mt-4">
                <h5 class="text-light mb-3">
                    @(rival?.Nombre ?? "Rival")
                    <span class="badge bg-secondary">@(rival?.CantidadCartasCapturadas ?? 0) capturas · @(rival?.Escobas ?? 0) escobas</span>
                </h5>
                <div class="cartas-preview">
                    @for (int i = 0; i < (rival?.CantidadCartasMano ?? 0); i++)
                    {
                        <figure class="carta-preview" title="Carta oculta">
                            <div class="carta-dorso"></div>
                        </figure>
                    }
                </div>
            </section>

            
            <section class="mt-4">
                <div class="container-fluid">
                    <div class="row align-items-center justify-content-center">


                        <div class="col-md-8 col-12 text-center mb-3 mb-md-0">
                            <h5 class="text-light mb-3">Cartas en la mesa <small>(mazo: @Model.CartasRestantesEnMazo)</small></h5>
                            <div class="cartas-preview justify-content-center" id="mesa">
                                @foreach (var carta in Model.CartasEnMesa)
                                {
                                    <button type="button" class="carta-seleccionable btn p-0" data-carta-id="@carta.Id" @(Model.EsMiTurno ? "" : "disabled")>
                                        <partial name="_Carta" model="carta" />
                                    </button>
                                }
                            </div>
                        </div>


                        <div class="col-md-4 col-12 text-center">
                            <div class="d-flex flex-column align-items-center justify-content-center w-100 gap-2">
                                <h5 class="text-light mb-1 fs-6 d-flex flex-column align-items-center">
                                    <span>Tus capturas</span>
                                    <span class="badge bg-secondary mt-1">
                                        @(Model.Jugadores.FirstOrDefault(j => j.UsuarioId == miUsuarioId)?.CantidadCartasCapturadas ?? 0) cap ·
                                        @(Model.Jugadores.FirstOrDefault(j => j.UsuarioId == miUsuarioId)?.Escobas ?? 0) esc
                                    </span>
                                </h5>

                                @if (Model.EsMiTurno)
                                {
                                    <div class="d-flex flex-column align-items-center justif-content-center gap-2 mt-2 w-100">
                                        <button id="capturar" class="btn btn-success btn-sm px-3 py-2 fw-bold text-uppercase shadow"
                                        disabled>Capturar (15)</button>

                                        <button id="descartar" class="btn btn-warning btn-sm px-3 py-2 fw-bold text-uppercase shadow"
                                        disabled>Descartar</button>
                                    </div>

                                    <p id="jugadaError" class="text-warning mt-1 mb-0 small text-center"></p>
                            }
                            </div>
                        </div>

                    </div>
                </div>
            </section>
        

            @* Mis cartas *@
            <div id="panel-jugador" class="panel-mano-flotante">
                <div class="container text-center">
                    <div class="cartas-preview" id="mano">
                        @foreach (var carta in Model.MisCartas)
                        {
                            <button type="button" class="carta-seleccionable btn p-0" data-carta-id="@carta.Id" @(Model.EsMiTurno ? "" : "disabled")>
                                <partial name="_Carta" model="carta" />
                            </button>
                        }
                    </div>
                </div>
            </div>
        }
        @if (Model.Estado == Escoba.Entidades.EnumPartida.Finalizado)
        {
            @* Se muestra el nombre de quien ganó a los dos jugadores, no solo al ganador. *@
            var nombresGanadores = Model.Jugadores
                .Where(j => Model.GanadoresUsuarioIds.Contains(j.UsuarioId))
                .Select(j => j.Nombre)
                .ToList();

            string textoGanador = nombresGanadores.Count == 0 ? ""
                : nombresGanadores.Count == 1 ? "Ganador: " + nombresGanadores[0]
                : "Empate entre " + string.Join(" y ", nombresGanadores);

            <div class="alert alert-info mt-4">
                🏁 @Model.MensajeFinal
                @if (textoGanador != "")
                {
                    <strong>@textoGanador</strong>
                }
                @if (nombresGanadores.Count == 1 && Model.GanadoresUsuarioIds.Contains(miUsuarioId))
                {
                    <span> ¡Ganaste!</span>
                }
            </div>
        }


    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        const sonidoClic = new Audio('/Assets/seleccion.mp3');
        const sonidoJugar = new Audio('/Assets/jugada.mp3');
        const sonidoError = new Audio('/Assets/error.mp3');
        const partidaId = "@Model.PartidaId";
        const usuarioId = @miUsuarioId;
        const maxJugadores = @maxJugadores; // Pasamos el límite desde C# a JS
        const urlSalir = "@Url.Action("Salir", "Partida", new { id = Model.PartidaId })";
        // Evita que el evento de abandono recargue esta página mientras el
        // usuario está saliendo voluntariamente de la mesa.
        let saliendo = false;

        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/partidahub")
            .withAutomaticReconnect()
            .build();


        //connection.on recibe lo que envia el Servicio (datos actualizados)
        connection.on("ActualizarJugadores", function(cantidadActual, nuevoJugadorNombre) {
            const lista = document.getElementById("listaJugadores");
            const estadoDiv = document.getElementById("estadoPartida");

            // Si la partida ya está en curso estos elementos no existen en la vista.
            if (!lista || !estadoDiv) {
                return;
            }

            const li = document.createElement("li");
            li.className = "list-group-item bg-dark text-light border-secondary d-flex justify-content-between align-items-center";
            li.innerHTML = `<span>${nuevoJugadorNombre}</span> <span class="badge bg-success">Conectado</span>`;
            lista.appendChild(li);

            // Validamos si la sala se llenó con este nuevo ingreso
            if (cantidadActual >= maxJugadores) {
                estadoDiv.className = "alert alert-success bg-dark text-success border-success py-2 mb-4 d-inline-block px-4";
                estadoDiv.innerHTML = ` Estado: <strong>¡Sala llena! Comenzando partida...</strong>`;

            } else {
                estadoDiv.innerHTML = ` Estado: <strong>Esperando jugadores (${cantidadActual}/${maxJugadores})</strong>`;
            }
        });

        // El servidor repartió las cartas: recargamos para ver nuestra mano y la mesa.
        connection.on("PartidaIniciada", function() {
            if (saliendo) {
                return;
            }

            location.reload();
        });

        connection.on("JugadorAbandono", function(nombreJugadorQueSeFue) {
            if (saliendo) {
                return;
            }

            // Recargamos la página si alguien se va para actualizar estados y contadores
            location.reload();
        });
        connection.on("ActualizarEstadoPartida", function () {
            if (saliendo) return;

            
            try {
                sonidoJugar.currentTime = 0;
                sonidoJugar.play().catch(() => { });
            } catch (e) { }

            
            setTimeout(() => {
                location.reload();
            }, 700);
        });

        // Al reconectar, SignalR crea una nueva conexión y los grupos no se
        // conservan: hay que volver a unirse a la mesa.
        connection.onreconnected(function() {
            connection.invoke("UnirseAMesa", partidaId, usuarioId).catch(function(err) {
                return console.error(err.toString());
            });
        });

        connection.start().then(function() {
            console.log("Conectado a SignalR con éxito.");
            // El Hub necesita ambos identificadores para asociar la conexión al jugador.
            connection.invoke("UnirseAMesa", partidaId, usuarioId).catch(function(err) {
                return console.error(err.toString());
            });
        }).catch(function(err) {
            return console.error(err.toString());
        });

        let cartaMano = null;
        const mesaSeleccionada = new Set();
        document.querySelectorAll("#mano .carta-seleccionable").forEach(function(boton) {
            boton.addEventListener("click", function() { 
                cartaMano = Number(boton.dataset.cartaId);
                document.querySelectorAll("#mano .carta-seleccionable").forEach(b => b.classList.remove("border","border-warning")); 
                boton.classList.add("border","border-warning"); 
                sonidoClic.currentTime = 0; 
                sonidoClic.play().catch(() => { }); 
                actualizarBotones(); 
            });
        });
        document.querySelectorAll("#mesa .carta-seleccionable").forEach(function(boton) {
            boton.addEventListener("click", function() { 
                const id=Number(boton.dataset.cartaId); 
                if(mesaSeleccionada.has(id)){mesaSeleccionada.delete(id);
                    boton.classList.remove("border","border-warning");
                }else
                {mesaSeleccionada.add(id);boton.classList.add("border","border-warning");
                } 
                sonidoClic.currentTime = 0; 
                sonidoClic.play().catch(() => { }); 
                actualizarBotones(); });
        });
        function actualizarBotones() { 
            const cap=document.getElementById("capturar"), des=document.getElementById("descartar"); 
            if(cap) cap.disabled=!cartaMano || mesaSeleccionada.size===0; 
            if(des) des.disabled=!cartaMano;
        }

        //aca se llaman a las jugadas con .invoke
        async function jugar(nombre, args) {
            const error = document.getElementById("jugadaError");
            try {
                const ok = await connection.invoke(nombre, ...args);
                if (ok) {
                    // Marcamos como saliendo momentáneamente para evitar conflictos externos
                    saliendo = true;

                    // Reproducimos el sonido de éxito inmediatamente
                    sonidoJugar.currentTime = 0;
                    sonidoJugar.play().catch((err) => {
                        console.log("Error al reproducir audio:", err);
                    });

                    // Damos un respiro de 500 milisegundos para que el archivo .mp3 (que ya vimos que carga perfecto en Network) se escuche en los parlantes, y luego recargamos la página para mostrar el nuevo estado de la mesa.
                    setTimeout(() => {
                        location.reload();
                    }, 1000);

                } else {
                    sonidoError.currentTime = 0;
                    sonidoError.play().catch(() => { });
                    if (error) error.textContent = "La jugada no es válida o ya no es tu turno.";
                }
            } catch (err) {
                sonidoError.currentTime = 0;
                sonidoError.play().catch(() => { });
                if (error) error.textContent = "No se pudo enviar la jugada.";
            }
        }

        document.getElementById("capturar")?.addEventListener("click", () => jugar("Capturar", [Number(partidaId), cartaMano, Array.from(mesaSeleccionada)]));
        document.getElementById("descartar")?.addEventListener("click", () => jugar("Descartar", [Number(partidaId), cartaMano]));

        document.getElementById("salirMesa").addEventListener("click", async function() {
            const boton = this;
            saliendo = true;
            boton.disabled = true;

            try {
                // Primero quitamos al jugador del grupo y de la partida; después
                // cerramos SignalR y navegamos a la lista de mesas.
                if (connection.state === signalR.HubConnectionState.Connected) {
                    await connection.invoke("SalirDeMesa", partidaId, usuarioId);
                    await connection.stop();
                }
            } catch (err) {
                console.error("No se pudo cerrar la conexión de la mesa:", err);
            } finally {
                window.location.href = urlSalir;
            }
        });
    </script>
}
