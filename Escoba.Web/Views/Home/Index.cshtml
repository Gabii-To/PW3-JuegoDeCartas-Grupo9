@{
    ViewData["Title"] = "Home Page";
}
@{
    // Verifica si el usuario tiene una sesión activa
    bool estaLogueado = !string.IsNullOrEmpty(Context.Session.GetString("UsuarioLogueado"));
}

<!-- ALERTA DE ÉXITO (Ej: Registro exitoso) -->
@if (TempData["MensajeSuccess"] != null)
{
    <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
        @TempData["MensajeSuccess"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- ALERTA DE ERROR (Ej: Usuario o contraseña incorrectos) -->
@if (TempData["ErrorLogin"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
        @TempData["ErrorLogin"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- ALERTA DE ERROR DE REGISTRO -->
@if (TempData["ErrorRegister"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
        @TempData["ErrorRegister"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<main class="container my-5">

    <!-- Bienvenida -->
    @if (!estaLogueado)
    {
     <div class="container-bar text-center py-5 mb-5">
        <h1 class="titulo-bar display-3 fw-bold mb-3">
            EL MEJOR LUGAR PARA JUGAR A LA <span class="subtitulo-neon">ESCOBA DE 15</span>
        </h1>
        <p class="lead text-light opacity-75 col-md-8 mx-auto">
            Pasá, sentate en la mesa y pedí un trago. Sumá 15, llevate el 7 de velo, juntá los oros y no dejes pasar ni una escoba limpia sobre la mesa.
        </p>
        <div class="mt-4">
            <button class="btn btn-bar btn-lg px-4 me-2" data-bs-toggle="modal" data-bs-target="#loginModal">
                Jugar Ahora
            </button>
        </div>
    </div>
    }


    <!-- Mesa disponible -->
    <section id="modalidades" class="my-5">
        <h2 class="text-center subtitulo-neon mb-4 fs-1">ELEGÍ TU MESA</h2>

        <div class="row g-4">
            <div class="col-md-8 mx-auto">
                <div class="mesa-truco h-100 d-flex flex-column justify-content-between p-4">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="fw-bold text-white mb-0">MANO A MANO </h3>
                            <span class="badge bg-warning text-dark fs-6">2 Jugadores</span>
                        </div>
                        <p class="text-light opacity-75">
                            Duelo directo en la mesa. Controlá las cartas en juego, calculá las sumas a 15 y disputale cada oro y cada 7 cara a cara a tu rival.
                        </p>
                        <ul class="list-unstyled small text-warning">
                            <li>✔ Duelo ágil y estratégico</li>
                            <li>✔ Control total de las cartas del pozo</li>
                            <li>✔ Ideal para partidas rápidas</li>
                        </ul>
                    </div>

                    <!-- Botones 1v1 -->
                    <div class="mt-3 d-flex gap-2">
                        @if (estaLogueado)
                        {
                            <button class="btn btn-bar flex-fill" data-bs-toggle="modal" data-bs-target="#crearPartidaModal">
                                Crear Partida
                            </button>
                            <a asp-controller="Partida" asp-action="Index" class="btn btn-outline-light flex-fill fw-bold">
                                Buscar Partida
                            </a>
                        }
                        else
                        {
                            <button class="btn btn-bar flex-fill" data-bs-toggle="modal" data-bs-target="#loginModal">
                                Crear Partida
                            </button>
                            <button class="btn btn-outline-light flex-fill fw-bold" data-bs-toggle="modal" data-bs-target="#loginModal">
                                Buscar Partida
                            </button>
                        }
                    </div>
                </div>
            </div>

        </div>
    </section>

    <section id="reglas" class="my-5 py-4">
        <div class="container">
            <h2 class="text-center subtitulo-neon mb-4 fs-1">¿CÓMO SE JUEGA A LA ESCOBA?</h2>
            <p class="text-center text-light opacity-75 col-md-8 mx-auto mb-5">
                El objetivo es simple: sumar 15 puntos combinando una carta de tu mano con una o más cartas que estén sobre la mesa. ¡Pero cuidado con dejar la mesa limpia para el que viene!
            </p>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="mesa-truco h-100 p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <span class="badge bg-warning text-dark fs-5 me-2">1</span>
                                <h4 class="fw-bold text-white mb-0">Sumá 15</h4>
                            </div>
                            <p class="text-light opacity-75 small">
                                Cada carta tiene su valor numérico (del 1 al 7, sota es 8, caballo es 9 y rey es 10). Jugá una carta de tu mano y sumá exactamente 15 con las de la mesa para capturarlas.
                            </p>
                        </div>
                        <ul class="list-unstyled small text-warning mb-0">
                            <li>✔ El Rey (10) con un 5 es un punto facil</li>
                        </ul>
                    </div>
                </div>

 
                <div class="col-md-4">
                    <div class="mesa-truco h-100 p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <span class="badge bg-warning text-dark fs-5 me-2">2</span>
                                <h4 class="fw-bold text-white mb-0">Hacé Escoba</h4>
                            </div>
                            <p class="text-light opacity-75 small">
                                Si al capturar cartas lográs limpiar completamente la mesa de golpe, hacés una <strong>Escoba</strong>. Se marca una carta boca arriba en tu montón y vale un punto extra al final.
                            </p>
                        </div>
                        <ul class="list-unstyled small text-warning mb-0">
                            <li>✔ No se puede hacer escoba en la última mano</li>
                        </ul>
                    </div>
                </div>


                <div class="col-md-4">
                    <div class="mesa-truco h-100 p-4 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex align-items-center mb-3">
                                <span class="badge bg-warning text-dark fs-5 me-2">3</span>
                                <h4 class="fw-bold text-white mb-0">El Conteo Final</h4>
                            </div>
                            <p class="text-light opacity-75 small">
                                Al terminar el mazo se contabilizan bonificaciones especiales según las cartas acumuladas en tus capturas:
                            </p>
                        </div>
                        <ul class="list-unstyled small text-warning mb-0">
                            <li>✔ <strong>Más cartas</strong> (1 pto) y <strong>Más oros</strong> (1 pto)</li>
                            <li>✔ <strong>El 7 de Oros</strong> o "Siete de Velo" (1 pto)</li>
                            <li>✔ <strong>Más setentas</strong> (las 4 cartas del 7)</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </section>


    <!-- Banner Informativo -->
    <div class="anotador-truco text-center my-5 p-4">
        <h4 class="text-warning mb-2">¿SOS NUEVO EN LA CANTINA?</h4>
        <p class="mb-0 text-light opacity-75">
            Registrate gratis en segundos para guardar tus estadísticas, acumular puntos en el ranking de la semana y armar mesas privadas con tus amigos.
        </p>
    </div>
    <!-- MODAL crearPartida form -->
    <div class="modal fade" id="crearPartidaModal" tabindex="-1" aria-labelledby="crearPartidaModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title subtitulo-neon" id="crearPartidaModalLabel">NUEVA MESA DE ESCOBA</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <form asp-controller="Partida" asp-action="Crear" method="post">
                    <div class="modal-body">
                        <div class="mb-3 text-start">
                            <label for="nombrePartida" class="form-label text-light fw-bold">
                                Nombre de la Partida:
                            </label>
                            <input type="text" 
                                   class="form-control" 
                                   id="nombrePartida" 
                                   name="nombrePartida" 
                                   placeholder="Ej: Cantina Nocturna..." 
                                   required 
                                   maxlength="30" />
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-bar">Crear Mesa</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</main>
