@inject IHttpContextAccessor HttpContextAccessor

<ul class="navbar-nav">
    @if (!string.IsNullOrEmpty(HttpContextAccessor.HttpContext?.Session.GetString("UsuarioLogueado")))
    {
        <li class="nav-item">
            <span class="nav-link text-dark fw-bold">
                ¡Hola, @HttpContextAccessor.HttpContext.Session.GetString("UsuarioLogueado")!
            </span>
        </li>
        <li class="nav-item">
            <a class="nav-link btn btn-link text-dark" asp-controller="Home" asp-action="Logout">
                Cerrar sesión
            </a>
        </li>
    }
    else
    {
        <li class="nav-item">
            <button type="button" class="btn btn-link nav-link text-dark" data-bs-toggle="modal" data-bs-target="#registerModal">
                Register
            </button>
        </li>
        <li class="nav-item">
            <button type="button" class="btn btn-link nav-link text-dark" data-bs-toggle="modal" data-bs-target="#loginModal">
                Login
            </button>
        </li>
    }
</ul>