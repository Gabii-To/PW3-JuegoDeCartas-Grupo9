@using Truco.Net.Entidades
@model IEnumerable<Truco.Net.Entidades.Partida>
@{
    ViewData["Title"] = "Salas Disponibles";
    string modoActual = ViewBag.ModoFiltro ?? "1v1";
}

<div class="container my-5">
    
    @if (TempData["ErrorCrear"] != null)
    {
        <div class="alert alert-danger bg-dark text-danger border-danger mb-4">
            @TempData["ErrorCrear"]
        </div>
    }

    <div class="container-bar mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="titulo-bar fs-2 text-start m-0">
                MESAS DISPONIBLES <span class="subtitulo-neon">(@modoActual.ToUpper())</span>
            </h2>
            
            <!-- Botón que abre el modal para crear mesa -->
            <button type="button" class="btn btn-bar" data-bs-toggle="modal" data-bs-target="#crearPartidaModal" onclick="setModoPartida('@modoActual')">
                + Crear Nueva Mesa
            </button>
        </div>
    </div>

    <!-- Lista Dinámica de Partidas Activas -->
    <div class="row g-3" id="listaPartidas" data-modo="@modoActual">
        @if (Model != null && Model.Any())
        {
            @foreach (var partida in Model)
            {
                bool es4P = partida.Modo.Equals("4p", System.StringComparison.OrdinalIgnoreCase);
                int maxJugadores = es4P ? 4 : 2;

                <div class="col-md-6 col-lg-4" data-partida-id="@partida.Id" data-modo="@partida.Modo">
                    <div class="mesa-truco p-3 h-100 d-flex flex-column justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="fw-bold text-white m-0">@partida.Nombre</h5>
                                <span class="badge @(es4P ? "bg-danger" : "bg-warning text-dark")">
                                    @(es4P ? "1v1v1v1" : "1 v 1")
                                </span>
                            </div>
                            <p class="small text-light opacity-75 mb-3">
                                Creador: <strong>@(partida.Creador?.UsuarioAsociado?.Nombre ?? "No disponible")</strong> (@partida.JugadoresActuales/@maxJugadores Jugadores)
                            </p>
                        </div>
                        <div>
                            <a asp-controller="Partida" asp-action="Escoba" asp-route-id="@partida.Id" class="btn @(es4P ? "btn-bar-danger" : "btn-bar") w-100 btn-sm">
                                Unirse a la Mesa
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5" id="sinPartidas">
                <p class="text-light opacity-75 fs-5">No hay mesas activas en este momento para este modo. ¡Creá una y empezá a jugar!</p>
            </div>
        }
    </div>
</div>

<!-- MODAL PARA INGRESAR EL NOMBRE DE LA PARTIDA -->
<div class="modal fade" id="crearPartidaModal" tabindex="-1" aria-labelledby="crearPartidaModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title subtitulo-neon" id="crearPartidaModalLabel">NUEVA MESA DE ESCOBA</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Partida" asp-action="Crear" method="post">
                <div class="modal-body">
                    <!-- Campo oculto para el modo -->
                    <input type="hidden" id="modalModoInput" name="modo" value="@modoActual" />

                    <div class="mb-3 text-start">
                        <label for="nombrePartida" class="form-label text-light fw-bold">
                            Nombre de la Partida:
                        </label>
                        <input type="text" 
                               class="form-control" 
                               id="nombrePartida" 
                               name="nombrePartida" 
                               placeholder="Ej: Mesa de la Esquina, La Escoba de Oro..." 
                               required 
                               maxlength="30" />
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-bar">Crear Mesa</button>
                </div>
            </form>
        </div>
    </div>
</div>



@section Scripts {
    <!-- SignalR mantiene sincronizado el listado mientras el usuario permanece
         en esta página, sin depender de polling ni recargas manuales. -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        const modoActual = "@modoActual";
        const listaPartidas = document.getElementById("listaPartidas");
        const urlEscoba = "@Url.Action("Escoba", "Partida")";

        function setModoPartida(modo) {
            document.getElementById('modalModoInput').value = modo;
        }

        function normalizarModo(modo) {
            return (modo || "").toLowerCase();
        }

        function actualizarEstadoVacio() {
            // El mensaje vacío se agrega o elimina según las tarjetas que
            // pertenecen al modo actualmente seleccionado.
            const tienePartidas = listaPartidas.querySelector("[data-partida-id]") !== null;
            const estadoVacio = document.getElementById("sinPartidas");

            if (tienePartidas && estadoVacio) {
                estadoVacio.remove();
            } else if (!tienePartidas && !estadoVacio) {
                listaPartidas.insertAdjacentHTML("beforeend",
                    '<div class="col-12 text-center py-5" id="sinPartidas">' +
                    '<p class="text-light opacity-75 fs-5">No hay mesas activas en este momento para este modo. ¡Creá una y empezá a jugar!</p>' +
                    '</div>');
            }
        }

        function crearTarjetaPartida(partida) {
            // Construimos la tarjeta con textContent en lugar de insertar datos
            // recibidos del servidor como HTML sin procesar.
            const es4P = normalizarModo(partida.modo) === "4p";
            const maxJugadores = es4P ? 4 : 2;
            const columna = document.createElement("div");
            columna.className = "col-md-6 col-lg-4";
            columna.dataset.partidaId = partida.id;
            columna.dataset.modo = partida.modo;

            const mesa = document.createElement("div");
            mesa.className = "mesa-truco p-3 h-100 d-flex flex-column justify-content-between";

            const contenido = document.createElement("div");
            const encabezado = document.createElement("div");
            encabezado.className = "d-flex justify-content-between align-items-center mb-2";

            const nombre = document.createElement("h5");
            nombre.className = "fw-bold text-white m-0";
            nombre.dataset.nombrePartida = "";
            nombre.textContent = partida.nombre;

            const badge = document.createElement("span");
            badge.className = es4P ? "badge bg-danger" : "badge bg-warning text-dark";
            badge.textContent = es4P ? "1v1v1v1" : "1 v 1";
            encabezado.append(nombre, badge);

            const detalles = document.createElement("p");
            detalles.className = "small text-light opacity-75 mb-3";
            detalles.dataset.detallesPartida = "";
            detalles.textContent = `Creador: ${partida.creador} (${partida.jugadoresActuales}/${maxJugadores} Jugadores)`;
            contenido.append(encabezado, detalles);

            const acciones = document.createElement("div");
            const enlace = document.createElement("a");
            enlace.className = `${es4P ? "btn-bar-danger" : "btn-bar"} btn w-100 btn-sm`;
            enlace.href = `${urlEscoba}?id=${encodeURIComponent(partida.id)}`;
            enlace.textContent = "Unirse a la Mesa";
            acciones.appendChild(enlace);

            mesa.append(contenido, acciones);
            columna.appendChild(mesa);
            return columna;
        }

        function perteneceAlModoActual(partida) {
            // El servidor envía todos los eventos; cada listado decide cuáles
            // mostrar según el filtro de modo de su propia página.
            return normalizarModo(partida.modo) === normalizarModo(modoActual);
        }

        function agregarOActualizarPartida(partida) {
            if (!perteneceAlModoActual(partida)) {
                return;
            }

            const existente = listaPartidas.querySelector(`[data-partida-id="${partida.id}"]`);
            if (existente) {
                // Los eventos pueden llegar varias veces o después de una
                // reconexión; actualizar la tarjeta evita duplicados.
                const detalles = existente.querySelector("[data-detalles-partida]");
                const maxJugadores = normalizarModo(partida.modo) === "4p" ? 4 : 2;
                detalles.textContent = `Creador: ${partida.creador} (${partida.jugadoresActuales}/${maxJugadores} Jugadores)`;
            } else {
                listaPartidas.appendChild(crearTarjetaPartida(partida));
            }

            actualizarEstadoVacio();
        }

        const lobbyConnection = new signalR.HubConnectionBuilder()
            .withUrl("/partidahub")
            // SignalR intenta recuperar la conexión automáticamente ante una
            // caída temporal de red.
            .withAutomaticReconnect()
            .build();

        lobbyConnection.on("SalaCreada", agregarOActualizarPartida);
        lobbyConnection.on("SalaActualizada", agregarOActualizarPartida);
        lobbyConnection.on("SalaEliminada", function(partida) {
            // Solo se elimina la tarjeta si pertenece al listado actual.
            const tarjeta = listaPartidas.querySelector(`[data-partida-id="${partida.id}"]`);
            if (tarjeta) {
                tarjeta.remove();
                actualizarEstadoVacio();
            }
        });

        lobbyConnection.onreconnected(function() {
            // Al reconectar, SignalR crea una nueva conexión y los grupos
            // anteriores deben registrarse nuevamente.
            lobbyConnection.invoke("UnirseAlLobby").catch(function(err) {
                console.error("No se pudo volver a unir al lobby:", err);
            });
        });

        lobbyConnection.start()
            .then(function() {
                // La carga inicial sigue viniendo de Razor; desde este punto
                // los eventos mantienen la lista actualizada en vivo.
                return lobbyConnection.invoke("UnirseAlLobby");
            })
            .catch(function(err) {
                console.error("No se pudo conectar al lobby en tiempo real:", err);
            });
    </script>
}