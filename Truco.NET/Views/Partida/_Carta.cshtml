@* Partial view de una carta: se reutiliza para la mesa y para la mano del jugador. *@
@model Truco.Net.Entidades.Carta

@* La ruta de la imagen se obtiene directamente desde Carta.RutaImagen. *@
@* Si falta un archivo, el evento onerror muestra una carta de reemplazo. *@
<figure class="carta-preview">
    <img src="@Model.RutaImagen"
         alt="@Model.Nombre"
         class="carta-imagen"
         loading="lazy"
         onerror="this.onerror=null; this.src='/Assets/cartas/carta-fallback.svg';" />
    <figcaption class="small text-light">@Model.Nombre</figcaption>
</figure>
